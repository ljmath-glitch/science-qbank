{
  "redirects": [
    { "source": "/", "destination": "/home.html", "permanent": false }
  ],
  "rewrites": [
    { "source": "/daily-qcard", "destination": "/daily.html" }
  ],
  "headers": [
    {
      "source": "/shortcuts/(.*).shortcut",
      "headers": [
        { "key": "Content-Type", "value": "application/octet-stream" }
      ]
    }
  ]
}
